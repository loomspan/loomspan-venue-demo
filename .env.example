# Set these in your shell; Spring does not automatically load this file.
OPENAI_API_KEY=replace-in-your-shell
ANNEX_MODEL=gpt-4.1
ANNEX_MODEL_BASE_URL=https://api.openai.com/v1
ANNEX_PORT=8080
# Optional Console integration. Use a separate long random API key.
ANNEX_OBSERVABILITY_ENABLED=false
ANNEX_OBSERVABILITY_API_KEY=
